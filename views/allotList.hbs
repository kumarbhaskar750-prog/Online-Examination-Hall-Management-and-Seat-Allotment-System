<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Allotment Details</title>
    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="style/Costyle.css">
</head>

<body>
    <nav class="navbar sticky-top navbar-expand-lg navbar-bg navbar-dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/addFac">Add Faculty</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/facDetails">Faculty Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/stuDetails">Student Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/examHall00">Seat Allotment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/allotList">Allotment List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/Clogout">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>


    <div class="container allotDe">

        <h2>List of Allotments</h2>

        <form action="/allotList" method="post" class="allotform">
            Search By :
            <label class="sroom">Room No : </label>
            <input type="text" class="room" name="sroom" placeholder="Enter Room No" required autocomplete="off">
            <label class="sdate">Exam Date : </label>
            <input type="date" class="date" name="sdate" required autocomplete="off">
            <label class="stime">Exam Time : </label>
            <input type="time" class="time" name="stime" required autocomplete="off">
            <input type="submit" value="Search" class="btn btn-danger" id="btnPo5"><span><button
                    class="allDe btn btn-danger"><a href="/facDetails">All</a></button></span>
        </form>

        <table class="table">
            <thead>
                <tr>
                    <th>Room</th>
                    <th>Seats</th>
                    <th>Exam Date</th>
                    <th>Exam Time</th>
                    <th>Exam Name</th>
                    <th>Faculty</th>
                </tr>
            </thead>
            {{#each allotlist}}
            <tr>
                <td>{{Room}}</td>
                <td>{{Seats}}</td>
                <td>{{Date}}</td>
                <td>{{Time}}</td>
                <td>{{Exam}}</td>
                <td>{{Faculty}}</td>
                <td>
                    <a href="/allotView/{{this._id}}"><i class="fa fa-eye fa-lg mx-4"></i></a>
                    <a href="/allotEdit/{{this._id}}"><i class="fa fa-pencil fa-lg"></i></a>
                    <a href="/allotDelete/{{this._id}}"><i class="fa fa-trash fa-lg mx-4"></i></a>
                </td>
            </tr>
            {{/each }}
        </table>
    </div>

    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

</html>