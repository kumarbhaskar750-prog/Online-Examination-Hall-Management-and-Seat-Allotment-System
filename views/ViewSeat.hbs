<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Seat Arrangement</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <style>
        h4 {
            color: #be3d31;
            margin: 6px 0;
            margin-bottom: 22px;
        }

        .editseat {
            position: relative;
            top: 40px;
            height: 415px;
            font-weight: 600;
        }

        .editseat #gobtn4 {
            position: absolute;
            top: -8%;
            left: -8%;
        }

        .editseat #gobtn4 a {
            color: white;
            text-decoration: none;
        }

        .tablecon {
            position: absolute;
            top: 28%;
        }

        .roomDe {
            position: relative;
            top: 3%;
            left: 28px;
            color: #ff0c00;
        }

        .room {
            position: absolute;
            top: -1%;
        }

        .time {
            position: absolute;
            top: -1%;
            left: 12%;
        }

        .date {
            position: absolute;
            top: -1%;
            left: 26%;
        }

        .seat {
            position: absolute;
            top: -1%;
            left: 44%;
        }

        .exam {
            position: absolute;
            top: -1%;
            left: 57%;
        }

        .fac {
            position: absolute;
            top: -1%;
            left: 76%;
        }
    </style>
</head>

<body>

    <div class="container editseat">
        <button class="btn btn-danger" id="gobtn4"><a href="/allotList">Go Back</a></button>

        <h4> ** Please kindly continue the next Roll No. from other Rooms , if left out. || **Status : {{status}}</h4>
        <div class="roomDe">

            <div class="room">
                Room No : {{Room}}
            </div>
            <div class="time">
                Exam Time : {{Time}}
            </div>
            <div class="date">
                Exam Date : {{Date}}
            </div>
            <div class="seat">
                Total Seats : {{Seat}}
            </div>
            <div class="exam">
                Exam Name : {{Exam}}
            </div>
            <div class="fac">
                Invigilator : {{Faculty}}
            </div>
        </div>
        <hr>

        <table class="table tablecon">

            <tr>
                <th>Seat No</th>
                <th>Roll No</th>
                <th>Department</th>
                <th>Semester</th>
            </tr>
            {{#each seatPlan}}
            <tr>
                <td>{{SeatNo}}</td>
                <td>{{Roll}}</td>
                <td>{{Department}}</td>
                <td>{{Semester}}</td>
            </tr>
            {{/each }}
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

</html>