<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title> Faculty Details</title>
    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="style/Costyle.css">
</head>

<body>
    <nav class="navbar sticky-top navbar-expand-lg navbar-bg navbar-dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/addFac">Add Faculty</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/facDetails">Faculty Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/stuDetails">Student Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/examHall00">Seat Allotment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/allotList">Allotment List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/Clogout">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container facDe">

        <h2>List of Faculties</h2>

        <form action="/facDetails" method="post" class="facform">
            Search By:
            <input type="text" class="fid" name="fid" placeholder="Enter Faculty Id" autocomplete="off">
            <input type="submit" value="Search" class="btn btn-danger" id="btnPo2"><span><button class="allDe btn btn-danger"><a href="/facDetails">All</a></button></span>
        </form>
        <hr>
        <table class="table">
            <thead>
                <tr>
                    <th>Faculty Id</th>
                    <th>Name</th>
                    <th>DOB</th>
                    <th>Email</th>
                    <th>Phone No</th>
                    <th>Department</th>
                </tr>
            </thead>
            {{#each regFac}}
            <tr>
                <td>{{Fid}}</td>
                <td>{{Name}}</td>
                <td>{{DOB}}</td>
                <td>{{Email}}</td>
                <td>{{Phone}}</td>
                <td>{{Department}}</td>
                <td>
                    <a href="/facEdit/{{this._id}}"><i class="fa fa-pencil fa-lg mx-4"></i></a>
                    <a href="/facDelete/{{this._id}}"><i class="fa fa-trash fa-lg "></i></a>
                </td>
            </tr>
            {{/each }}
        </table>
    </div>

    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

</html>