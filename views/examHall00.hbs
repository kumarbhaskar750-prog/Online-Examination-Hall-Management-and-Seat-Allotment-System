<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Allotment</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel="stylesheet" href="style/Costyle.css">
</head>

<body>

    <nav class="navbar sticky-top navbar-expand-lg navbar-bg navbar-dark">
        <div class="container-fluid">
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/addFac">Add Faculty</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/facDetails">Faculty Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/stuDetails">Student Details</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/examHall00">Seat Allotment</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/allotList">Allotment List</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/Clogout">Logout</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>

    <div class="container eformdiv">

        <h2>Add Hall Details</h2>

        <form action="/examHall00" method="POST">
            <div class="eh3">

                <label class="eroom">Room No : </label>
                <input type="text" class="room" name="eroom" placeholder="Enter Room No" required autocomplete="off">
                <label class="eseat">Total Seat : </label>
                <input type="number" class="seat" name="eseat" placeholder="Enter Total Seats" required
                    autocomplete="off">
                <label class="edate">Exam Date : </label>
                <input type="date" class="date" name="edate" required autocomplete="off">
                <label class="etime">Exam Time : </label>
                <input type="time" class="time" name="etime" required autocomplete="off">
                <label class="ename">Exam Name : </label>
                <input type="text" class="name" name="ename" placeholder="Name of Examination" required
                    autocomplete="off">
                <label class="eassignfac">Assign Invigilator :</label>
                <select name="efac" class="assignfac">
                    <option></option>
                    {{#each facList }}
                    <option>{{Name}}</option>
                    {{/each}}
                </select>
                <input type="submit" value="Allot Seat" class="btn btn-danger" id="btnPo4">
            </div>
            <div class="deptPart">
                <div class="eh1">
                    <div class="eh1form">

                        <h2>Enter Details for 1st Department</h2>

                        <label class="dep1">Department :</label>
                        <select class="depteh1" name="dept1" required>
                            <option></option>
                            <option>CE</option>
                            <option>ME</option>
                            <option>ECE</option>
                            <option>EE</option>
                            <option>CSE</option>
                            <option>BCA</option>
                            <option>MCA</option>
                            <option>BBA</option>
                            <option>MBA</option>
                        </select>
                        <label class="sem1">Semester :</label>
                        <select class="semeh1" name="sem1" required>
                            <option></option>
                            <option>1</option>
                            <option>2</option>
                            <option>3</option>
                            <option>4</option>
                            <option>5</option>
                            <option>6</option>
                            <option>7</option>
                            <option>8</option>
                        </select>
                        <label class="roll1">From Roll No :</label> <input type="text" name="roll1" id="roll1"
                            placeholder=" Enter Roll No" required autocomplete="off">
                        <label class="roll2">To Roll No :</label> <input type="text" name="roll2" id="roll2"
                            placeholder=" Enter Roll No" required autocomplete="off">
                    </div>
                </div>
                <hr id="partition">
                <div class="eh2">
                    <div class="eh2form">

                        <h2>Enter Details for 2nd Department</h2>

                        <label class="dep2">Department :</label>
                        <select class="depteh2" name="dept2" required>
                            <option></option>
                            <option>CE</option>
                            <option>ME</option>
                            <option>ECE</option>
                            <option>EE</option>
                            <option>CSE</option>
                            <option>BCA</option>
                            <option>MCA</option>
                            <option>BBA</option>
                            <option>MBA</option>
                        </select>
                        <label class="sem2">Semester :</label>
                        <select class="semeh2" name="sem2" required>
                            <option></option>
                            <option>1</option>
                            <option>2</option>
                            <option>3</option>
                            <option>4</option>
                            <option>5</option>
                            <option>6</option>
                            <option>7</option>
                            <option>8</option>
                        </select>
                        <label class="roll3">From Roll No :</label> <input type="text" name="roll3" id="roll3"
                            placeholder=" Enter Roll No" required autocomplete="off">
                        <label class="roll4">To Roll No :</label> <input type="text" name="roll4" id="roll4"
                            placeholder=" Enter Roll No" required autocomplete="off">
                    </div>
                </div>
            </div>

        </form>
    </div>
</body>


<!-- JavaScript Bundle with Popper -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
    integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
    crossorigin="anonymous"></script>
</body>

</html>