<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Faculty</title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <!-- CSS only -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .editfa {
            position: relative;
            top: 100px;
            height: 415px;
            font-weight: 600;
        }

        .editfa #gobtn1 {
            position: absolute;
            top: 79%;
            left: 5%;
        }

        .editfa #gobtn1 a {
            color: white;
            text-decoration: none;
        }

        .fform {
            position: relative;
            top: 40px;
            left: 22%;
            height: 340px;
            width: 660px;
            padding: 20px 30px;
            border: 2px solid black;
            border-radius: 20px;
        }

        .fform .fid {
            position: absolute;
            top: 28%;
            left: 5%;
        }

        .fform .id {
            position: absolute;
            top: 28%;
            left: 18%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .fname {
            position: absolute;
            top: 45%;
            left: 5%;
        }

        .fform .name {
            position: absolute;
            top: 45%;
            left: 14%;
            width: 33%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .fdob {
            position: absolute;
            top: 62%;
            left: 5%;
        }

        .fform .dob {
            position: absolute;
            top: 62%;
            left: 12%;
            width: 35%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .femail {
            position: absolute;
            top: 28%;
            left: 55%;
        }

        .fform .email {
            position: absolute;
            top: 28%;
            left: 66%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .fphno {
            position: absolute;
            top: 45%;
            left: 55%;
        }

        .fform .phone {
            position: absolute;
            top: 45%;
            left: 68%;
            width: 27%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .fdept {
            position: absolute;
            top: 62%;
            left: 55%;
        }

        .fform .dept {
            position: absolute;
            top: 62%;
            left: 70%;
            width: 25%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .fform .editbtn1 {
            position: absolute;
            top: 79%;
            left: 79%;
        }

        h2 {
            color: #be3d31;
            text-decoration: underline;
            margin: 6px 0;
            margin-bottom: 22px;
        }
    </style>
</head>

<body>

    <div class="container editfa">

        <form action="/editFac" class="fform" method="POST">
            <button class="btn btn-danger" id="gobtn1"><a href="/facDetails">Go Back</a></button>
            <h2>Edit Invigilator</h2>
            <label class="fid">Faculty Id : </label>
            <input type="text" class="id" name="fid" value="{{fid}}" placeholder="Enter Faculty Id" required readonly
                autocomplete="off">
            <label class="fname">Name : </label>
            <input type="text" class="name" name="fname" value="{{name}}" placeholder="Enter Name" required
                autocomplete="off">
            <label class="fdob">DOB : </label>
            <input type="date" class="dob" name="fdob" value="{{dob}}" placeholder="Enter DOB" required
                autocomplete="off">
            <label class="femail">Email Id : </label>
            <input type="email" class="email" name="femail" value="{{email}}" placeholder="Enter Email" required
                autocomplete="off">
            <label class="fphno">Phone-No : </label>
            <input type="text" class="phone" name="fphno" value="{{phone}}" placeholder="Enter Ph-No" required
                autocomplete="off">
            <label class="fdept">Department : </label>
            <select class="dept" name="fdept" required>
                <option></option>
                <option>Civil</option>
                <option>Mechanical</option>
                <option>Electonics</option>
                <option>Electicals</option>
                <option>Computer Science</option>
                <option>Computer Application</option>
                <option>Business Administration</option>
            </select>
            <input type="submit" value="Edit Faculty" class="btn btn-danger editbtn1">
        </form>
    </div>


    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

</html>