  <div class="resetbody">
    <div class="container2">
      <div class="main2-container">
        <h2>Reset-Password</h2>
      </div>
      <form action="/Resetpass" class="resetform" method="POST">
        <label class="resetroll">Roll No : </label>
        <input type="text" class="roll" name="rroll" placeholder="Enter Your Roll No" required autocomplete="off">
        <label class="resetpass">New Password : </label>
        <input type="password" class="pass" name="rpass" placeholder="Enter Password" required autocomplete="off">
        <div class="Rpass"><P>8 character with one min(a,A,1,#)</P></div>
        <label class="resetcpass">Re-enter : </label>
        <input type="password" class="cpass" name="rcpass" placeholder="Re-Enter Password" required autocomplete="off">
        <input type="submit" value="Reset" class="mybtn">
        {{!-- <div class="racc"><label>Go get done your Login | </label><a href="/login">Login</a></div> --}}
      </form>
    </div>
</div>
