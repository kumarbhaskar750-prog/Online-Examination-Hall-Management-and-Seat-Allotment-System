<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Student Login</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">
    <link rel="stylesheet" href="style/Sustyle.css">
</head>

<body>

    <nav class="navbar sticky-top navbar-expand-lg navbar-bg navbar-dark">
        <div class="container-fluid">
            <a class="navbar-brand" href="/home">Examination Seat Allotment System</a>
            <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
                data-bs-target="#navbarSupportedContent" aria-controls="navbarSupportedContent" aria-expanded="false"
                aria-label="Toggle navigation">
                <span class="navbar-toggler-icon"></span>
            </button>
            <div class="collapse navbar-collapse" id="navbarSupportedContent">
                <ul class="navbar-nav mx-auto mb-2 mb-lg-0">
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/home">HOME</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/about">ABOUT</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/login">LOGIN</a>
                    </li>
                    <li class="nav-item">
                        <a class="nav-link active " aria-current="page" href="/register">REGISTER</a>
                    </li>
                </ul>
            </div>
        </div>
    </nav>
    <div class="body">
        <div class="container1">
            <div class="main1-container">
                <h2>LOGIN AS :</h2>
            </div>
            <button id="btn1"><a href="/Cologin">Coordinator</a></button>
            <button id="btn2"><a href="/Falogin">Faculty</a></button>
            <button id="btn3"><a href="/Sulogin">Student</a></button>
        </div>
        <div class="login ">
            <div class="container2">
                <div class="main2-container">
                    <h2>STUDENT LOGIN</h2>
                </div>
                <form action="/Sulogin" class="sform" method="POST">
                    <label class="sroll">Roll No : </label>
                    <input type="text" name="sroll" placeholder="Enter Roll No" required autocomplete="off">
                    <label class="spass">Password : </label>
                    <input type="password" name="spass" placeholder="Enter Password" required autocomplete="off">
                    <h4 class="h4">Must be 8 character with one min(a,A,1,#)</h4>
                    <a href="/Resetpass" class="newpass">Forgot Password?</a>
                    <input type="submit" value="Login" class="mybtn">

                    <div class="acc"><label>Don't Have Account? | </label><a href="/register">Register</a></div>
                </form>
            </div>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

</html>