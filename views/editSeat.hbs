<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=, initial-scale=1.0">
    <title>Edit Allotment</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/css/bootstrap.min.css" rel="stylesheet"
        integrity="sha384-Zenh87qX5JnK2Jl0vWa8Ck2rdkQ2Bzep5IDxbcnCeuOxjzrPF/et3URy9Bv1WTRi" crossorigin="anonymous">
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/font-awesome/4.7.0/css/font-awesome.min.css">

    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
        }

        .editseat {
            position: relative;
            top: 100px;
            height: 415px;
            font-weight: 600;
        }

        .editseat #gobtn3 {
            position: absolute;
            top: 76%;
            left: 5%;
        }

        .editseat #gobtn3 a {
            color: white;
            text-decoration: none;
        }

        .eform {
            position: relative;
            top: 40px;
            left: 22%;
            height: 340px;
            width: 660px;
            padding: 20px 30px;
            border: 2px solid black;
            border-radius: 20px;
        }

        .eform .eroom {
            position: absolute;
            top: 28%;
            left: 5%;
        }

        .eform .room {
            position: absolute;
            top: 28%;
            left: 18%;
            width: 21%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .eform .edate {
            position: absolute;
            top: 40%;
            left: 5%;
        }

        .eform .date {
            position: absolute;
            top: 40%;
            left: 19%;
            width: 20%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .eform .etime {
            position: absolute;
            top: 54%;
            left: 5%;
        }

        .eform .time {
            position: absolute;
            top: 54%;
            left: 19%;
            width: 20%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .eform .ename {
            position: absolute;
            top: 28%;
            left: 50%;
        }

        .eform .name {
            position: absolute;
            top: 28%;
            left: 66%;
            width: 26%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .eform .eassignfac {
            position: absolute;
            top: 40%;
            left: 50%;
        }

        .eform .assignfac {
            position: absolute;
            top: 40%;
            left: 71%;
            width: 21%;
            font-size: 1rem;
            padding: 0 10px;
            border-left: none;
            border-right: none;
            border-top: none;
            outline: none;
        }

        .eform .editbtn3 {
            position: absolute;
            top: 76%;
            left: 79%;
        }

        h2 {
            color: #be3d31;
            text-decoration: underline;
            margin: 6px 0;
            margin-bottom: 22px;
        }
    </style>

</head>

<body>

    <div class="container editseat">

        <form action="/editSeat" class="eform" method="POST">
            <button class="btn btn-danger" id="gobtn3"><a href="/allotList">Go Back</a></button>
            <h2>Edit Allotment</h2>
            <label class="eroom">Room No : </label>
            <input type="text" class="room" name="eroom" value="{{room}}" placeholder="Enter Room No" readonly required
                autocomplete="off">
            <label class="edate">Exam Date : </label>
            <input type="date" class="date" name="edate" value="{{date}}" required autocomplete="off">
            <label class="etime">Exam Time : </label>
            <input type="time" class="time" name="etime" value="{{time}}" required autocomplete="off">
            <label class="ename">Exam Name : </label>
            <input type="text" class="name" name="ename" value="{{ename}}" placeholder="Name of Examination" required
                autocomplete="off">

            <label class="eassignfac">Assign Invigilator :</label>
            <select name="efac" class="assignfac">
                <option></option>
                {{#each facList }}
                <option>{{Name}}</option>
                {{/each}}
            </select>
            <input type="submit" value="Edit Allot" class="btn btn-danger editbtn3">
            {{!-- <div class="racc"><label>Already Have an Account? | </label><a href="/Sulogin">Login</a></div>
            --}}
        </form>

    </div>
</body>

</html>