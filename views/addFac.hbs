<div class="fformdiv">

    <h2>Add Invigilator</h2>

    <form action="/addFac" class="fform" method="POST">

        <label class="fid">Faculty Id : </label>
        <input type="text" class="id" name="fid" placeholder="Enter Faculty Id" required autocomplete="off">
        <label class="fname">Name : </label>
        <input type="text" class="name" name="fname" placeholder="Enter Name" required autocomplete="off">
        <label class="fdob">DOB: </label>
        <input type="date" class="dob" name="fdob" placeholder="Enter DOB" required autocomplete="off">
        <label class="femail">Email Id : </label>
        <input type="email" class="email" name="femail" placeholder="Enter Email" required autocomplete="off">
        <label class="fphno">Phone-No : </label>
        <input type="text" class="phone" name="fphno" placeholder="Enter Ph-No" required autocomplete="off">
        <label class="fdept">Department : </label>
        <select class="dept" name="fdept">
            <option></option>
            <option>Civil</option>
            <option>Mechanical</option>
            <option>Electonics</option>
            <option>Electicals</option>
            <option>Computer Science</option>
            <option>Computer Application</option>
            <option>Business Administration</option>
        </select>
        <input type="submit" value="Add Invigilator" class="btn btn-danger" id="btnPo1">
    </form>
    </div>
    
    <!-- JavaScript Bundle with Popper -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.2.2/dist/js/bootstrap.bundle.min.js"
        integrity="sha384-OERcA2EqjJCMA+/3y+gxIOqMEjwtxJY7qPCqsdltbNJuaOe923+mo//f6V8Qbsw3"
        crossorigin="anonymous"></script>
</body>

